# Modelo do arquivo de credenciais. Este arquivo vai para o git, sem valores reais.
# Para usar: copie para um arquivo chamado .env e preencha com os dados do seu projeto.
# Onde encontrar: painel do Supabase > Project Settings.

# URL do projeto
SUPABASE_URL=https://seu-projeto.supabase.co

# Chave SECRETA (service_role). Usada só pelo script Python, na sua máquina.
# Nunca coloque esta chave no front-end nem no git.
SUPABASE_SECRET_KEY=sua_chave_secreta
